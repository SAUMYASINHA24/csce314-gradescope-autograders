{
-- Lexer for the arithmetic language of Problem 5, generated by Alex.
--
-- Alex turns the regular-expression rules below into a fast DFA-based
-- scanner (ExprLexer.hs). We use the "posn" wrapper so every token knows
-- its line and column, which gives readable error messages.

module ExprLexer
  ( Token (..)
  , TokenKind (..)
  , AlexPosn (..)
  , scanTokens
  ) where
}

%wrapper "posn"

$digit = 0-9

tokens :-

  $white+                 ;                                   -- skip spaces
  "--".*                  ;                                   -- skip comments
  $digit+                 { \p s -> Token p (TInt (read s)) }
  "+"                     { \p _ -> Token p TPlus }
  "-"                     { \p _ -> Token p TMinus }
  "*"                     { \p _ -> Token p TTimes }
  "/"                     { \p _ -> Token p TDiv }
  "("                     { \p _ -> Token p TLParen }
  ")"                     { \p _ -> Token p TRParen }

{
data TokenKind
  = TInt Int
  | TPlus
  | TMinus
  | TTimes
  | TDiv
  | TLParen
  | TRParen
  deriving (Eq, Show)

data Token = Token AlexPosn TokenKind
  deriving (Eq, Show)

-- | Like Alex's alexScanTokens, but returns Left with the position of a bad
-- character instead of crashing the whole program with `error`.
scanTokens :: String -> Either String [Token]
scanTokens str = go (alexStartPos, '\n', [], str)
  where
    go inp@(pos, _, _, rest) =
      case alexScan inp 0 of
        AlexEOF -> Right []
        AlexError ((AlexPn _ line col), _, _, c : _) ->
          Left ("lexical error at line " ++ show line ++ ", column " ++ show col
                ++ ": unexpected character " ++ show c)
        AlexError _ -> Left "lexical error at end of input"
        AlexSkip inp' _ -> go inp'
        AlexToken inp' len action -> (action pos (take len rest) :) <$> go inp'
}
