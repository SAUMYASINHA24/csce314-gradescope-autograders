{
-- Parser for the arithmetic language of Problem 5, generated by Happy.
--
-- Happy turns the context-free grammar below into an LALR(1) parser
-- (ExprParser.hs). Precedence and associativity are declared instead of
-- being encoded by hand in the grammar:
--   *  and /  bind tighter than  +  and  -
--   all four are left-associative:  10 - 4 - 3  means  (10 - 4) - 3
--   unary minus binds tightest:      2 * -3     means  2 * (0 - 3)
--
-- The parser builds values of the student's own Expr type, so the same
-- AST the student evaluates is the one the test file describes.

module ExprParser (parseExpr) where

import ExprLexer
import HW1 (Expr (..))
}

%name parseTokens
%tokentype { Token }
%monad { Either String } { >>= } { return }
%error { parseError }

%token
  int   { Token _ (TInt $$) }
  '+'   { Token _ TPlus }
  '-'   { Token _ TMinus }
  '*'   { Token _ TTimes }
  '/'   { Token _ TDiv }
  '('   { Token _ TLParen }
  ')'   { Token _ TRParen }

%left '+' '-'
%left '*' '/'
%right NEG

%%

Exp : Exp '+' Exp             { Add $1 $3 }
    | Exp '-' Exp             { Sub $1 $3 }
    | Exp '*' Exp             { Mul $1 $3 }
    | Exp '/' Exp             { Div $1 $3 }
    | '-' Exp %prec NEG       { Sub (Num 0) $2 }
    | '(' Exp ')'             { $2 }
    | int                     { Num $1 }

{
parseError :: [Token] -> Either String a
parseError [] = Left "parse error: unexpected end of input"
parseError (Token (AlexPn _ line col) kind : _) =
  Left ("parse error at line " ++ show line ++ ", column " ++ show col
        ++ ": unexpected " ++ describe kind)
  where
    describe (TInt n) = "number " ++ show n
    describe TPlus    = "'+'"
    describe TMinus   = "'-'"
    describe TTimes   = "'*'"
    describe TDiv     = "'/'"
    describe TLParen  = "'('"
    describe TRParen  = "')'"

-- | Lex and parse a string into an Expr.
parseExpr :: String -> Either String Expr
parseExpr s = scanTokens s >>= parseTokens
}
