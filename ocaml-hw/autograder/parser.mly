/* Parser for the arithmetic language of Problem 5, generated by ocamlyacc.

   ocamlyacc turns this context-free grammar into an LALR(1) parser
   (parser.ml). Precedence and associativity are declared rather than
   encoded in the grammar, which keeps the grammar short and unambiguous:
     - TIMES and DIV bind tighter than PLUS and MINUS (later = tighter)
     - all four are left-associative: 10 - 4 - 3 = (10 - 4) - 3
     - unary minus binds tightest:     2 * -3   = 2 * (0 - 3)

   The actions build values of the student's own Hw1.expr type, so the AST
   the test file describes is exactly the one the student's eval receives. */

%{
  open Hw1
%}

%token <int> INT
%token PLUS MINUS TIMES DIV LPAREN RPAREN EOF

%left PLUS MINUS
%left TIMES DIV
%nonassoc UMINUS

%start main
%type <Hw1.expr> main

%%

main:
  | expr EOF                   { $1 }
;

expr:
  | expr PLUS expr             { Add ($1, $3) }
  | expr MINUS expr            { Sub ($1, $3) }
  | expr TIMES expr            { Mul ($1, $3) }
  | expr DIV expr              { Div ($1, $3) }
  | MINUS expr %prec UMINUS    { Sub (Num 0, $2) }
  | LPAREN expr RPAREN         { $2 }
  | INT                        { Num $1 }
;
