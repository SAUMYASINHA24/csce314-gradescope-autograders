(* Lexer for the arithmetic language of Problem 5, generated by ocamllex.
   ocamllex turns these regular-expression rules into a DFA-based scanner
   (lexer.ml). Lexing positions give readable error messages. *)
{
  open Parser

  exception Lex_error of string

  let error lexbuf msg =
    let p = Lexing.lexeme_start_p lexbuf in
    raise (Lex_error (Printf.sprintf "lexical error at column %d: %s"
                        (p.Lexing.pos_cnum - p.Lexing.pos_bol + 1) msg))
}

let digit = ['0'-'9']
let white = [' ' '\t' '\r' '\n']

rule token = parse
  | white+        { token lexbuf }
  | digit+ as n   { INT (int_of_string n) }
  | '+'           { PLUS }
  | '-'           { MINUS }
  | '*'           { TIMES }
  | '/'           { DIV }
  | '('           { LPAREN }
  | ')'           { RPAREN }
  | eof           { EOF }
  | _ as c        { error lexbuf (Printf.sprintf "unexpected character '%c'" c) }
